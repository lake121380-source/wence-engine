# 复制此文件为 .env 并填入真实值
TIKHUB_API_KEY=your_tikhub_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DATABASE_URL=sqlite:///./content_studio.db
CHROMA_PERSIST_DIR=./chroma_db
DEBUG=true

# 飞书应用凭证（在飞书开放平台 https://open.feishu.cn 创建企业自建应用后获取）
# 需开通权限：bitable:app（多维表格）
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT（至少 32 字符的随机字符串；可用 node -e "require('crypto').randomBytes(48).toString('base64url')|Get-Content"）
JWT_SECRET=your-strong-random-jwt-secret-at-least-32-chars
JWT_EXPIRE_HOURS=168

# 管理员初始化接口鉴权密钥（首次部署时专用，初始化完成后可删除）
ADMIN_INIT_TOKEN=your-strong-random-admin-init-token

# WeChat（公众号服务器验证 Token，随机字符串即可）
WECHAT_TOKEN=your-random-wechat-token
WECHAT_APPID=your_wechat_appid
WECHAT_APPSECRET=your_wechat_appsecret

# 邮箱验证
EMAIL_VERIFY_ENABLED=true
EMAIL_VERIFY_EXPIRE_HOURS=24
BACKEND_PUBLIC_URL=http://localhost:8080

# SMTP（QQ 邮箱）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq@qq.com
SMTP_PASSWORD=your_qq_smtp_auth_code
SMTP_USE_TLS=false
SMTP_USE_SSL=true
EMAIL_FROM=your_qq@qq.com
EMAIL_FROM_NAME=文策引擎

# Open API（外部系统调用文案生成）
OPEN_API_ENABLED=false
OPEN_API_KEY=your-strong-open-api-key
OPEN_API_USER_ID=0
OPEN_API_REQUIRE_SUBSCRIPTION=true
