<template>
  <div>
    <!-- 页头 -->
    <div class="page-header">
      <div>
        <div class="page-title">爆款选题库</div>
        <div class="page-subtitle">关键词搜索爆款短视频，一键同步至飞书多维表格</div>
      </div>
      <n-button secondary @click="showPullModal = true">
        <template #icon><n-icon><CloudDownloadOutline /></n-icon></template>
        从飞书读取关键词
      </n-button>
    </div>

    <!-- 搜索区 -->
    <div class="search-card">
      <n-form inline :label-width="0" style="gap:12px;flex-wrap:wrap;">
        <n-form-item style="flex:1;min-width:200px;">
          <n-input
            v-model:value="keyword"
            placeholder="输入行业关键词，如：美妆、减脂、护肤"
            size="large"
            clearable
            @keydown.enter="search"
          >
            <template #prefix><n-icon><SearchOutline /></n-icon></template>
          </n-input>
        </n-form-item>

        <n-form-item label="平台" label-style="color:rgba(255,255,255,.6)">
          <n-checkbox-group v-model:value="platforms" style="display:flex;gap:8px;">
            <n-checkbox value="douyin">抖音</n-checkbox>
            <n-checkbox value="xiaohongshu">小红书</n-checkbox>
            <n-checkbox value="bilibili">B站</n-checkbox>
          </n-checkbox-group>
        </n-form-item>

        <n-form-item label="排序" label-style="color:rgba(255,255,255,.6)">
          <n-select v-model:value="sort" :options="sortOptions" style="width:120px;" />
        </n-form-item>

        <n-form-item label="数量" label-style="color:rgba(255,255,255,.6)">
          <n-select v-model:value="limit" :options="limitOptions" style="width:90px;" />
        </n-form-item>

        <n-form-item>
          <n-button type="primary" size="large" :loading="searching" @click="search">
            <template #icon><n-icon><SearchOutline /></n-icon></template>
            搜索爆款
          </n-button>
        </n-form-item>
      </n-form>
    </div>

    <!-- 操作栏 -->
    <div v-if="results.length" class="action-bar">
      <n-space>
        <n-button secondary @click="toggleAll">
          {{ allSelected ? '取消全选' : '全选' }}
        </n-button>
        <n-button
          :disabled="!selectedIds.length"
          @click="showFeishuModal = true"
        >
          <template #icon><n-icon><CloudUploadOutline /></n-icon></template>
          同步到飞书 ({{ selectedIds.length }})
        </n-button>
        <n-button
          type="primary"
          :disabled="!selectedIds.length"
          @click="useAsTopics"
        >
          <template #icon><n-icon><SparklesOutline /></n-icon></template>
          用于生成文案
        </n-button>
        <n-button
          :disabled="!selectedIds.length"
          @click="batchAnalyzeSelected"
        >
          <template #icon><n-icon><AnalyticsOutline /></n-icon></template>
          批量分析爆款 ({{ selectedIds.length }})
        </n-button>
      </n-space>
      <n-text depth="3" style="font-size:13px;">共 {{ results.length }} 条结果</n-text>
    </div>

    <!-- 结果网格 -->
    <n-spin :show="searching">
      <div v-if="!results.length && !searching" class="empty-state-big">
        <n-icon size="48" color="rgba(255,255,255,0.12)"><SearchOutline /></n-icon>
        <p>输入关键词搜索爆款短视频</p>
      </div>

      <n-grid v-else :cols="3" :x-gap="14" :y-gap="14">
        <n-gi v-for="v in results" :key="`${v.platform}-${v.video_id}`">
          <div
            class="video-card"
            :class="{ selected: isSelected(v) }"
            @click="toggleSelect(v)"
          >
            <!-- 选择框 -->
            <div class="select-badge">
              <n-checkbox
                :checked="isSelected(v)"
                @click.stop
                @update:checked="toggleSelect(v)"
              />
            </div>

            <!-- 封面 -->
            <div class="video-cover">
              <img
                v-if="v.cover_url"
                :src="v.cover_url"
                alt="cover"
                style="width:100%;height:100%;object-fit:cover;"
                @error="e => e.target.style.display='none'"
              />
              <div v-else class="cover-placeholder">
                <n-icon size="32" color="rgba(255,255,255,.2)"><VideocamOutline /></n-icon>
              </div>
              <div class="platform-tag">{{ platformZh(v.platform) }}</div>
            </div>

            <!-- 内容 -->
            <div class="video-body">
              <div class="video-title">{{ v.title || '(无标题)' }}</div>
              <div class="video-author">@{{ v.author || '未知作者' }}</div>

              <div class="video-stats">
                <span class="stat">
                  <n-icon size="13"><HeartOutline /></n-icon>
                  {{ formatNum(v.like_count) }}
                </span>
                <span class="stat">
                  <n-icon size="13"><ChatbubbleOutline /></n-icon>
                  {{ formatNum(v.comment_count) }}
                </span>
                <span v-if="v.play_count" class="stat">
                  <n-icon size="13"><PlayOutline /></n-icon>
                  {{ formatNum(v.play_count) }}
                </span>
              </div>

              <div v-if="v.tags?.length" class="video-tags">
                <n-tag
                  v-for="tag in (v.tags || []).slice(0,3)"
                  :key="tag"
                  size="tiny"
                  :bordered="false"
                  style="margin-right:4px;background:rgba(99,102,241,.15);color:#818cf8;"
                >
                  #{{ tag }}
                </n-tag>
              </div>

              <!-- 爆款比率徽章 -->
              <div v-if="v._analysis" class="ratio-badges">
                <n-tag size="tiny" :type="ratioLevel(v._analysis.like_play_level).type" style="margin-right:4px;">
                  赞{{ ratioLevel(v._analysis.like_play_level).text }}
                </n-tag>
                <n-tag size="tiny" :type="ratioLevel(v._analysis.comment_play_level).type" style="margin-right:4px;">
                  评{{ ratioLevel(v._analysis.comment_play_level).text }}
                </n-tag>
                <n-tag size="tiny" :type="ratioLevel(v._analysis.collect_play_level).type">
                  藏{{ ratioLevel(v._analysis.collect_play_level).text }}
                </n-tag>
              </div>

              <!-- 分析按钮 -->
              <div class="card-actions">
                <n-button
                  v-if="v._analysis"
                  size="tiny"
                  secondary
                  @click.stop="viewAnalysis(v)"
                >查看分析</n-button>
                <n-button
                  size="tiny"
                  secondary
                  :loading="analyzingIds.has(v.id)"
                  @click.stop="analyzeVideo(v)"
                >
                  <template #icon><n-icon><AnalyticsOutline /></n-icon></template>
                  {{ v._analysis ? '重新分析' : '分析爆款' }}
                </n-button>
              </div>
            </div>
          </div>
        </n-gi>
      </n-grid>
    </n-spin>

    <!-- 已保存选题 Tab -->
    <div v-if="savedTopics.length" style="margin-top:40px;">
      <div class="section-title">已保存选题</div>
      <n-data-table
        :columns="savedColumns"
        :data="savedTopics"
        :pagination="{ pageSize: 10 }"
        :bordered="false"
        size="small"
        style="--n-border-color:rgba(255,255,255,.06);"
      />
    </div>

    <!-- 飞书同步弹窗 -->
    <n-modal v-model:show="showFeishuModal" :mask-closable="false" style="width:520px;">
      <n-card title="同步到飞书多维表格" :bordered="false" style="background:#1a1d27;">
        <n-form :model="feishuForm" label-placement="left" :label-width="120" :show-feedback="false">
          <n-form-item label="写入方式">
            <n-radio-group v-model:value="feishuForm.mode" button-style="solid">
              <n-radio-button value="existing">写入已有表格</n-radio-button>
              <n-radio-button value="new">自动创建表格</n-radio-button>
            </n-radio-group>
          </n-form-item>
          <n-form-item label="App Token" required>
            <n-input
              v-model:value="feishuForm.app_token"
              placeholder="飞书多维表格 App Token"
              clearable
            />
          </n-form-item>
          <n-form-item v-if="feishuForm.mode === 'existing'" label="Table ID">
            <n-input
              v-model:value="feishuForm.table_id"
              placeholder="数据表 ID（tbl 开头）"
              clearable
            />
            <template #feedback>
              <n-text depth="3" style="font-size:12px;">URL中 ?table= 后面的字符串即为 Table ID</n-text>
            </template>
          </n-form-item>
          <n-form-item v-else label="数据表名称">
            <n-input v-model:value="feishuForm.table_name" />
          </n-form-item>
        </n-form>

        <n-alert type="info" style="margin-top:12px;margin-bottom:16px;" :show-icon="false">
          <n-text style="font-size:13px;">
            将同步 <b>{{ selectedIds.length }}</b> 条选题到飞书。
            {{ feishuForm.mode === 'existing' ? '写入已有表格（rows 追加）' : '若数据表不存在将自动创建' }}。
          </n-text>
        </n-alert>

        <n-space justify="end">
          <n-button @click="showFeishuModal = false">取消</n-button>
          <n-button
            type="primary"
            :loading="syncing"
            :disabled="!feishuForm.app_token || (feishuForm.mode === 'existing' && !feishuForm.table_id)"
            @click="syncToFeishu"
          >
            确认同步
          </n-button>
        </n-space>
      </n-card>
    </n-modal>

    <!-- 从飞书拉取关键词弹窗 -->
    <n-modal v-model:show="showPullModal" :mask-closable="false" style="width:500px;">
      <n-card title="从飞书自动拉取关键词搜索" :bordered="false" style="background:#1a1d27;">
        <n-alert type="info" :bordered="false" style="margin-bottom:16px;border-radius:8px;">
          读取飞书数据表中的关键词列，自动触发爆款视频搜索并保存到选题库
        </n-alert>
        <n-form :model="pullForm" label-placement="left" :label-width="110" :show-feedback="false">
          <n-form-item label="App Token" required>
            <n-input v-model:value="pullForm.app_token" placeholder="飞书多维表格 App Token" clearable />
          </n-form-item>
          <n-form-item label="Table ID" required>
            <n-input v-model:value="pullForm.table_id" placeholder="数据表 ID（tbl 开头）" clearable />
          </n-form-item>
          <n-form-item label="关键词字段名">
            <n-input v-model:value="pullForm.keyword_field" placeholder="飞书表格中关键词列的字段名" />
          </n-form-item>
          <n-form-item label="平台">
            <n-checkbox-group v-model:value="pullForm.platforms" style="display:flex;gap:8px;">
              <n-checkbox value="douyin">抖音</n-checkbox>
              <n-checkbox value="xiaohongshu">小红书</n-checkbox>
              <n-checkbox value="bilibili">B站</n-checkbox>
            </n-checkbox-group>
          </n-form-item>
          <n-form-item label="每词抓取数">
            <n-input-number v-model:value="pullForm.limit_per_keyword" :min="5" :max="50" style="width:120px;" />
          </n-form-item>
        </n-form>

        <!-- 拉取进度 -->
        <div v-if="pulling" class="pull-progress">
          <n-spin size="small" />
          <span style="margin-left:10px;font-size:13px;color:rgba(255,255,255,.5);">正在从飞书读取关键词并搜索...</span>
        </div>

        <n-space justify="end" style="margin-top:16px;">
          <n-button @click="showPullModal = false">取消</n-button>
          <n-button
            type="primary"
            :loading="pulling"
            :disabled="!pullForm.app_token || !pullForm.table_id"
            @click="pullFromFeishu"
          >
            开始拉取
          </n-button>
        </n-space>
      </n-card>
    </n-modal>

    <!-- 博主发现弹窗 -->
    <div class="discover-section">
      <n-divider />
      <div class="section-title">
        批量发现行业博主
        <n-text depth="3" style="font-size:13px;font-weight:400;margin-left:8px;">
          按关键词在抖音搜索头部博主，批量加入博主资料库
        </n-text>
      </div>

      <div style="display:flex;gap:12px;margin-bottom:16px;">
        <n-input
          v-model:value="discoverKeyword"
          placeholder="输入行业关键词搜索博主"
          clearable
          style="max-width:320px;"
          @keydown.enter="discoverCreators"
        />
        <n-button :loading="discovering" @click="discoverCreators">搜索博主</n-button>
      </div>

      <n-spin :show="discovering">
        <n-grid v-if="discoveredCreators.length" :cols="4" :x-gap="12" :y-gap="12">
          <n-gi v-for="c in discoveredCreators" :key="c.platform_id">
            <div class="creator-discover-card" :class="{ added: c.already_added }">
              <n-avatar :src="c.avatar_url" round :size="40" />
              <div style="flex:1;min-width:0;">
                <div style="font-weight:500;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                  {{ c.nickname }}
                </div>
                <div style="font-size:12px;color:rgba(255,255,255,.4);">
                  {{ formatNum(c.follower_count) }} 粉丝
                </div>
              </div>
              <n-button
                size="tiny"
                :type="c.already_added ? 'default' : 'primary'"
                :disabled="c.already_added"
                @click="addCreator(c)"
              >
                {{ c.already_added ? '已添加' : '添加' }}
              </n-button>
            </div>
          </n-gi>
        </n-grid>
      </n-spin>
    </div>

    <!-- 爆款分析详情弹窗 -->
    <n-modal v-model:show="showAnalysisModal" preset="card" style="width: 640px;">
      <template #header>🔥 爆款分析 — {{ currentAnalysisTitle }}</template>
      <div v-if="currentAnalysis" class="analysis-modal">
        <!-- 3比率 -->
        <div class="ratio-row">
          <div class="ratio-item">
            <div class="ratio-label">点赞率</div>
            <div class="ratio-value">{{ currentAnalysis.like_play_ratio != null ? (currentAnalysis.like_play_ratio * 100).toFixed(2) + '%' : 'N/A' }}</div>
            <n-tag size="small" :type="ratioLevel(currentAnalysis.like_play_level).type">
              {{ ratioLevel(currentAnalysis.like_play_level).text }}
            </n-tag>
          </div>
          <div class="ratio-item">
            <div class="ratio-label">评论率</div>
            <div class="ratio-value">{{ currentAnalysis.comment_play_ratio != null ? (currentAnalysis.comment_play_ratio * 100).toFixed(2) + '%' : 'N/A' }}</div>
            <n-tag size="small" :type="ratioLevel(currentAnalysis.comment_play_level).type">
              {{ ratioLevel(currentAnalysis.comment_play_level).text }}
            </n-tag>
          </div>
          <div class="ratio-item">
            <div class="ratio-label">收藏率</div>
            <div class="ratio-value">{{ currentAnalysis.collect_play_ratio != null ? (currentAnalysis.collect_play_ratio * 100).toFixed(2) + '%' : 'N/A' }}</div>
            <n-tag size="small" :type="ratioLevel(currentAnalysis.collect_play_level).type">
              {{ ratioLevel(currentAnalysis.collect_play_level).text }}
            </n-tag>
          </div>
        </div>

        <n-divider style="margin: 16px 0;" />

        <!-- AI 分析 -->
        <n-tabs type="line" animated>
          <n-tab-pane name="resonance" tab="情感共鸣">
            <div class="analysis-text">{{ currentAnalysis.resonance_analysis || '暂无分析' }}</div>
          </n-tab-pane>
          <n-tab-pane name="discussion" tab="讨论度">
            <div class="analysis-text">{{ currentAnalysis.discussion_analysis || '暂无分析' }}</div>
          </n-tab-pane>
          <n-tab-pane name="value" tab="实用价值">
            <div class="analysis-text">{{ currentAnalysis.value_analysis || '暂无分析' }}</div>
          </n-tab-pane>
          <n-tab-pane name="why" tab="爆款原因">
            <div class="analysis-text analysis-highlight">{{ currentAnalysis.why_viral_summary || '暂无分析' }}</div>
          </n-tab-pane>
        </n-tabs>
      </div>
    </n-modal>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, h } from 'vue'
import { useRouter } from 'vue-router'
import { useMessage } from 'naive-ui'
import { NButton, NTag } from 'naive-ui'
import {
  SearchOutline, CloudUploadOutline, CloudDownloadOutline, SparklesOutline,
  VideocamOutline, HeartOutline, ChatbubbleOutline,
  PlayOutline, AnalyticsOutline,
} from '@vicons/ionicons5'
import { topicsApi, creatorsApi, analyzerApi } from '../api/index.js'
import { useGenerateStore } from '../stores/generate.js'

const router = useRouter()
const message = useMessage()
const generateStore = useGenerateStore()

// ── 搜索状态 ────────────────────────────────
const keyword = ref('')
const platforms = ref(['douyin', 'xiaohongshu'])
const sort = ref('likes')
const limit = ref(30)
const searching = ref(false)
const results = ref([])
const selected = ref(new Set())

// ── 爆款分析状态 ─────────────────────────────
const analyzingIds = ref(new Set())
const showAnalysisModal = ref(false)
const currentAnalysis = ref(null)
const currentAnalysisTitle = ref('')

const sortOptions = [
  { label: '最多点赞', value: 'likes' },
  { label: '最新发布', value: 'new' },
]
const limitOptions = [
  { label: '20条', value: 20 },
  { label: '30条', value: 30 },
  { label: '50条', value: 50 },
]

// ── 选中逻辑 ────────────────────────────────
const selectedIds = computed(() => {
  return results.value
    .filter(v => selected.value.has(`${v.platform}-${v.video_id}`))
    .map(v => v.id)
    .filter(Boolean)
})
const allSelected = computed(() =>
  results.value.length > 0 && results.value.every(v => isSelected(v))
)

function isSelected(v) {
  return selected.value.has(`${v.platform}-${v.video_id}`)
}
function toggleSelect(v) {
  const key = `${v.platform}-${v.video_id}`
  if (selected.value.has(key)) selected.value.delete(key)
  else selected.value.add(key)
}
function toggleAll() {
  if (allSelected.value) selected.value.clear()
  else results.value.forEach(v => selected.value.add(`${v.platform}-${v.video_id}`))
}

// ── 搜索 ────────────────────────────────────
async function search() {
  if (!keyword.value.trim()) return message.warning('请输入关键词')
  if (!platforms.value.length) return message.warning('请选择至少一个平台')
  searching.value = true
  selected.value.clear()
  try {
    const { data } = await topicsApi.search({
      keyword: keyword.value.trim(),
      platforms: platforms.value,
      limit: limit.value,
      sort: sort.value,
      save: true,
    })
    results.value = data.videos || []
    if (!results.value.length) message.info('未找到相关内容，请换个关键词试试')
    else message.success(`找到 ${results.value.length} 条爆款内容`)
  } catch (e) {
    message.error(e.response?.data?.detail || '搜索失败')
  } finally {
    searching.value = false
  }
}

// ── 飞书同步 ─────────────────────────────────
const showFeishuModal = ref(false)
const syncing = ref(false)
const feishuForm = ref({ app_token: '', table_name: '爆款选题库', table_id: '', mode: 'new' })

async function syncToFeishu() {
  if (!feishuForm.value.app_token) return
  syncing.value = true
  try {
    const payload = {
      topic_ids: selectedIds.value,
      app_token: feishuForm.value.app_token,
      table_name: feishuForm.value.table_name,
    }
    if (feishuForm.value.mode === 'existing' && feishuForm.value.table_id) {
      payload.table_id = feishuForm.value.table_id
    }
    const { data } = await topicsApi.syncFeishu(payload)
    message.success(`成功同步 ${data.written} 条到飞书！`)
    showFeishuModal.value = false
    await loadSavedTopics()
  } catch (e) {
    message.error(e.response?.data?.detail || '同步失败，请检查 App Token 和飞书应用权限')
  } finally {
    syncing.value = false
  }
}

// ── 从飞书拉取关键词 ──────────────────────────
const showPullModal = ref(false)
const pulling = ref(false)
const pullForm = ref({
  app_token: '',
  table_id: '',
  keyword_field: '关键词',
  platforms: ['douyin', 'xiaohongshu'],
  limit_per_keyword: 20,
})

async function pullFromFeishu() {
  pulling.value = true
  try {
    const { data } = await topicsApi.feishuPullKeywords({
      app_token: pullForm.value.app_token,
      table_id: pullForm.value.table_id,
      keyword_field: pullForm.value.keyword_field,
      platforms: pullForm.value.platforms,
      limit_per_keyword: pullForm.value.limit_per_keyword,
      save: true,
    })
    const kwCount = data.keywords?.length || 0
    const videoCount = data.total_videos || 0
    message.success(`读取到 ${kwCount} 个关键词，共抓取 ${videoCount} 条选题`)
    showPullModal.value = false
    if (data.videos?.length) {
      results.value = data.videos
    }
    await loadSavedTopics()
  } catch (e) {
    message.error(e.response?.data?.detail || '拉取失败，请检查 App Token / Table ID 和飞书权限')
  } finally {
    pulling.value = false
  }
}

// ── 用于生成文案 ─────────────────────────────
function useAsTopics() {
  const selectedVideos = results.value.filter(v => isSelected(v))
  if (!selectedVideos.length) return
  const first = selectedVideos[0]
  const topicText = selectedVideos.length === 1
    ? first.title
    : selectedVideos.map(v => v.title).join('\n')
  generateStore.setPrefillTopic({
    title: topicText,
    description: first.description || '',
    keyword: first.keyword || keyword.value,
    platform: first.platform || 'douyin',
  })
  router.push('/generate')
}

// ── 已保存选题 ────────────────────────────────
const savedTopics = ref([])

const savedColumns = [
  { title: '标题', key: 'title', ellipsis: { tooltip: true }, width: 280 },
  { title: '关键词', key: 'keyword', width: 100 },
  {
    title: '平台', key: 'platform', width: 80,
    render: row => platformZh(row.platform),
  },
  {
    title: '点赞', key: 'like_count', width: 80, sorter: 'default',
    render: row => formatNum(row.like_count),
  },
  { title: '作者', key: 'author', width: 100, ellipsis: true },
  {
    title: '状态', key: 'status', width: 90,
    render: row => h(NTag, {
      size: 'small', bordered: false,
      type: { '已采纳': 'success', '已使用': 'info', '已忽略': 'default', '待评审': 'warning' }[row.status] || 'default',
    }, () => row.status),
  },
  {
    title: '飞书', key: 'feishu_synced', width: 70,
    render: row => row.feishu_synced ? '✅' : '—',
  },
]

async function loadSavedTopics() {
  try {
    const { data } = await topicsApi.list({ limit: 100 })
    savedTopics.value = data
  } catch (e) { /* ignore */ }
}

// ── 博主发现 ──────────────────────────────────
const discoverKeyword = ref('')
const discovering = ref(false)
const discoveredCreators = ref([])

async function discoverCreators() {
  if (!discoverKeyword.value.trim()) return message.warning('请输入关键词')
  discovering.value = true
  try {
    const { data } = await topicsApi.discoverCreators({
      keyword: discoverKeyword.value.trim(),
      limit: 30,
    })
    discoveredCreators.value = data.creators || []
    if (!discoveredCreators.value.length) message.info('未找到相关博主')
  } catch (e) {
    message.error(e.response?.data?.detail || '搜索博主失败')
  } finally {
    discovering.value = false
  }
}

async function addCreator(c) {
  try {
    await creatorsApi.add('douyin', c.unique_id)
    c.already_added = true
    message.success(`已添加博主 @${c.nickname}`)
  } catch (e) {
    message.error(e.response?.data?.detail || '添加失败')
  }
}

// ── 工具函数 ──────────────────────────────────
function platformZh(p) {
  return { douyin: '抖音', xiaohongshu: '小红书', bilibili: 'B站' }[p] || p
}
function formatNum(n) {
  if (!n) return '0'
  if (n >= 10000) return (n / 10000).toFixed(1) + 'w'
  return n.toLocaleString()
}

// ── 爆款分析函数 ─────────────────────────────
async function analyzeVideo(v) {
  if (!v.id) return message.warning('该视频尚未保存，请先搜索保存后再分析')
  analyzingIds.value.add(v.id)
  try {
    const { data } = await topicsApi.analyzeTopic(v.id)
    // 把分析结果附加到结果列表对应项
    const idx = results.value.findIndex(r => r.id === v.id)
    if (idx !== -1) results.value[idx] = { ...results.value[idx], _analysis: data }
    currentAnalysis.value = data
    currentAnalysisTitle.value = v.title || '(无标题)'
    showAnalysisModal.value = true
  } catch (e) {
    message.error(e.response?.data?.detail || '分析失败')
  } finally {
    analyzingIds.value.delete(v.id)
  }
}

function viewAnalysis(v) {
  currentAnalysis.value = v._analysis
  currentAnalysisTitle.value = v.title || '(无标题)'
  showAnalysisModal.value = true
}

function ratioLevel(level) {
  if (level === 'high') return { text: '高', type: 'success' }
  if (level === 'medium') return { text: '中', type: 'warning' }
  return { text: '低', type: 'default' }
}

async function batchAnalyzeSelected() {
  if (!selectedIds.value.length) return
  const ids = selectedIds.value
  message.info(`开始批量分析 ${ids.length} 条内容...`)
  try {
    await topicsApi.batchAnalyze({ topic_ids: ids })
    message.success('批量分析完成')
  } catch (e) {
    message.error(e.response?.data?.detail || '批量分析失败')
  }
}

onMounted(loadSavedTopics)
</script>

