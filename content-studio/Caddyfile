{
    key_type rsa2048
}

www.wenceai.xyz {
    redir https://wenceai.xyz{uri} permanent
}

wenceai.xyz {
    encode gzip

    redir /admin /admin/

    handle /api* {
        reverse_proxy backend:8080
    }

    handle /health {
        reverse_proxy backend:8080
    }

    handle_path /admin/* {
        reverse_proxy admin:80
    }

    handle {
        reverse_proxy frontend:80
    }
}

# Temporary plain HTTP entry for domain callbacks/integrations when external TLS is unstable.
http://wenceai.xyz, http://www.wenceai.xyz {
    encode gzip

    redir /admin /admin/

    handle /api* {
        reverse_proxy backend:8080
    }

    handle /health {
        reverse_proxy backend:8080
    }

    handle_path /admin/* {
        reverse_proxy admin:80
    }

    handle {
        reverse_proxy frontend:80
    }
}

# Temporary plain HTTP fallback for direct IP access while domain HTTPS is blocked upstream.
http://124.221.70.55 {
    encode gzip

    redir /admin /admin/

    handle /api* {
        reverse_proxy backend:8080
    }

    handle /health {
        reverse_proxy backend:8080
    }

    handle_path /admin/* {
        reverse_proxy admin:80
    }

