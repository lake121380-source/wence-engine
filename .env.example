ANTHROPIC_API_KEY=
CHROMA_PERSIST_DIR=
DATABASE_URL=
DEBUG=
GEMINI_API_KEY=
LARK_APP_ID=
LARK_APP_SECRET=
TIKHUB_API_KEY=

# GGGUA 易支付 V1（https://pay.gggua.com/doc.html）
# 未完成商户进件、回调地址和密钥配置前保持为空，线上会明确返回 503。
PAYMENT_PROVIDER=gggua
GGGUA_PID=
GGGUA_KEY=
GGGUA_BASE_URL=https://pay.gggua.com
# 必须是公网 HTTPS URL，不能带查询参数；生产域名示例：
GGGUA_NOTIFY_URL=https://wence.tongzhuo.ink/api/payment/notify
GGGUA_RETURN_URL=
# 建议生产填写服务器公网出口 IP；为空时从请求地址推导。Docker/Caddy 部署请
# 配置真实反向代理地址（不要信任任意 X-Forwarded-For）。
GGGUA_CLIENT_IP=
PAYMENT_TRUSTED_PROXY_IPS=127.0.0.1,::1
PAYMENT_HTTP_TIMEOUT_SECONDS=15
PAYMENT_ORDER_EXPIRE_MINUTES=15
# 轮询订单状态时的 GGGUA 查询兜底；间隔用于避免频繁请求上游。
PAYMENT_QUERY_FALLBACK=true
PAYMENT_QUERY_INTERVAL_SECONDS=10
# 仅本地开发可用；生产必须保持 false。模拟支付还要求 DEBUG=true。
PAYMENT_DEV_MODE=false
